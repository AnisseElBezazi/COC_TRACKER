<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Clash League Tracker{% endblock %}</title>
    <link rel="icon" href="{{ asset('img/legende.png') }}">
    {# Une seule feuille de style (polices et petites images embarquées) : voir tools/build-css.php #}
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
    <script>
        /* Le fond continue son mouvement d'une page à l'autre : on mémorise le début de la session. */
        try {
            const t0 = +(sessionStorage.fondT0 || (sessionStorage.fondT0 = Date.now()));
            document.documentElement.style.setProperty('--fond-t', (((Date.now() - t0) / 1000) % 140).toFixed(1));
        } catch (e) { /* stockage indisponible : le fond repart simplement du début */ }
    </script>
    <script defer>{{ source('_fond.js')|raw }}</script>
</head>
<body>
<div class="bg"></div><div class="veil"></div><div class="glow"></div><div class="brume"></div><canvas id="braises" aria-hidden="true"></canvas>
<div class="wrap">
    <div class="brand"><a href="{{ path('app_accueil') }}"><img class="logo" src="{{ asset('img/legende.png') }}" alt="" width="46" height="46"><b>CLASH<span>LEAGUE</span> TRACKER</b></a></div>
    {% for message in app.flashes('erreur') %}<div class="err" role="alert"><span class="warn">!</span>{{ message }}</div>{% endfor %}
    {% block body %}{% endblock %}
</div>
</body>
</html>

# Exemple de configuration pour tester le projet : copier ce fichier en .env (« cp .env.exemple .env »).
# Les valeurs ci-dessous fonctionnent telles quelles en local. Ce sont des valeurs de développement,
# sans rapport avec un vrai serveur : ne pas les utiliser en production.

APP_ENV=dev
APP_SECRET=d7fdf1d49a5a082920789e6690929634
DEFAULT_URI=http://localhost

# Base de données SQLite locale (aucune installation nécessaire). Les migrations du projet sont écrites pour SQLite.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_dev.db"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# API Clash of Clans : aucune clé n'est nécessaire.
# Par défaut, l'application appelle https://api.quentindeglas.com/v1.
# Si ce serveur est en panne, décommenter la ligne suivante pour lire les réponses enregistrées dans fixtures/api :
# COC_API_URL=fixtures/api
